{
	"schemaVersion": 1,
	"id": "simple-blueprints",
	"version": "${version}",
	"name": "Simple Blueprints",
	"description": "A simple mod for copying and building structures",
	"authors": [
		"Maxboxx"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/simple-blueprints/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"maxboxx.blueprints.SimpleBlueprints"
		],
		"client": [
			"maxboxx.blueprints.SimpleBlueprintsClient"
		]
	},
	"mixins": [
		"simple-blueprints.mixins.json",
		{
			"config": "simple-blueprints.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}